FROM golang:1.23-bookworm AS source
WORKDIR /app
COPY services/go.mod services/go.sum* ./
RUN go mod download
COPY services/webhook ./webhook
COPY services/operator ./operator

FROM source AS tests
CMD ["go", "test", "./..."]

FROM source AS build
ARG SERVICE
RUN --mount=type=cache,target=/root/.cache/go-build \
    test -n "$SERVICE" && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /app/server "./$SERVICE"

FROM gcr.io/distroless/static:nonroot AS runtime
COPY --from=build /app/server /server
EXPOSE 8080
ENTRYPOINT ["/server"]
